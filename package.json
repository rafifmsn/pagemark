{
  "name": "pagemark",
  "displayName": "Pagemark",
  "version": "1.0.2",
  "description": "Clip any web page to clean Markdown with side panel, auto-copy whitelist, and token counter",
  "author": "Rafif Muchsin <rafif@rafifmsn.com>",
  "homepage": "https://github.com/rafifmsn/pagemark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafifmsn/pagemark.git"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "markdown",
    "clipper",
    "side-panel",
    "web-clipper"
  ],
  "scripts": {
    "dev": "plasmo dev",
    "dev:verbose": "plasmo dev --verbose",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build",
    "build:source": "plasmo build --source-maps",
    "build:chrome": "plasmo build --target=chrome-mv3 --zip",
    "build:firefox": "plasmo build --target=firefox-mv3 --zip",
    "package": "plasmo package",
    "build:all": "npm run build:chrome && npm run build:firefox"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "markdown-to-jsx": "^9.7.15",
    "pagemark-core": "^1.1.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "overrides": {
    "@parcel/watcher": "^2.5.6",
    "svelte": "^4.2.19",
    "content-security-policy-parser": "^0.6.0",
    "msgpackr": "^1.10.1",
    "esbuild": "^0.25.0",
    "tsup": "^8.3.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/chrome": "0.0.258",
    "@types/node": "^20.19.0",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "prettier": "3.2.4",
    "tailwindcss": "3",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "contextMenus",
      "storage",
      "$SIDE_PANEL_PERMISSION",
      "clipboardWrite"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "commands": {
      "convert-to-markdown": {
        "suggested_key": {
          "default": "Alt+K",
          "mac": "Alt+K"
        },
        "description": "Convert current page to Markdown"
      }
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "rafifmsn@pagemark",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  }
}
